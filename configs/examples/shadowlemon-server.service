[Unit]
Description=shadowlemon server daemon
After=network-online.target network.service networking.service NetworkManager.service systemd-networkd.service
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=exec
User=shadowlemon
Group=shadowlemon
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment="SHADOWLEMON_SERVER_CONFIG_JSON_FILE=/etc/shadowlemon_server_config.json"
Environment="SHADOWLEMON_LOG_NO_TIMESTAMP=true"
ExecStartPre=+/usr/bin/mkdir -p /var/run/shadowlemon
ExecStartPre=+/usr/bin/chown -R shadowlemon:shadowlemon /var/run/shadowlemon
ExecStartPre=+/usr/bin/chmod 775 /var/run/shadowlemon
ExecStart=/usr/bin/shadowlemon server run
Nice=-10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target