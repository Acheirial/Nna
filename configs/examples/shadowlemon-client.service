[Unit]
Description=shadowlemon client daemon
After=network-online.target network.service networking.service NetworkManager.service systemd-networkd.service
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=exec
Environment="SHADOWLEMON_CLIENT_CONFIG_JSON_FILE=/etc/shadowlemon_client_config.json"
ExecStart=/usr/bin/shadowlemon client run
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target