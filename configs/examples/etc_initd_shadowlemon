#!/bin/sh /etc/rc.common

START=99
STOP=01

SHADOWLEMON_BIN="/usr/bin/shadowlemon"
SHADOWLEMON_CONFIG="/etc/shadowlemon_client_config.json"

start() {
    echo "Starting shadowlemon client..."
    # The pid file is maintained by shadowlemon itself (<config dir>/shadowlemon.pid),
    # so this script must not create or delete a pid file of its own.
    export SHADOWLEMON_CLIENT_CONFIG_JSON_FILE=$SHADOWLEMON_CONFIG
    "$SHADOWLEMON_BIN" client start
    RC=$?
    if [ $RC -eq 0 ]; then
        echo "shadowlemon client is started"
        exit 0
    else
        echo "failed to start shadowlemon client"
        exit $RC
    fi
}

stop() {
    echo "Stopping shadowlemon client..."
    # shadowlemon reads its own pid file and sends SIGTERM to the daemon.
    "$SHADOWLEMON_BIN" client stop
    RC=$?
    if [ $RC -eq 0 ]; then
        echo "shadowlemon client is stopped"
    else
        echo "failed to stop shadowlemon client"
    fi
}